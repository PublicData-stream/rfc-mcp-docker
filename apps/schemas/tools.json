              "additionalProperties": false
            },
            "items": {"type": "array", "items": {"$ref": "#/$defs/item"}, "maxItems": 100}
          },
          "required": [
            "schema_version",
            "generation_id",
            "publication_sequence",
            "next_cursor",
            "truncated",
            "coverage",
            "items"
          ],
          "additionalProperties": false
        },
        {"$ref": "#/$defs/error"}
      ],
      "$defs": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "invalid_arguments",
                "invalid_query_syntax",
                "unknown_query_field",
                "unknown_relation",
                "query_too_complex",
                "invalid_regex",
                "rfc_not_found",
                "section_not_found",
                "ambiguous_section",
                "invalid_byte_range",
                "invalid_utf8_boundary",
                "unsupported_source_encoding",
                "cursor_invalid",
                "cursor_expired",
                "generation_unavailable",
                "corpus_not_ready",
                "incomplete_index",
                "deadline_exceeded",
                "resource_limit_exceeded",
                "sandbox_unavailable",
                "source_policy_restricted",
                "source_unavailable",
                "search_unavailable"
              ]
            },
            "message": {"type": "string"},
            "span": {
              "type": "array",
              "items": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "minItems": 2,
              "maxItems": 2
            },
            "candidate_section_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}, "maxItems": 10},
            "source_url": {"type": "string"}
          },
          "required": ["code", "message"],
          "additionalProperties": false
        },
        "item": {
          "type": "object",
          "properties": {
            "id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "title": {"type": "string"},
            "stream": {"anyOf": [{"type": "string"}, {"type": "null"}]},
            "source_url": {"type": "string"},
            "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "status": {"anyOf": [{"type": "string"}, {"type": "null"}]}
          },
          "required": ["id", "title", "stream", "source_url", "digest", "status"],
          "additionalProperties": false
        }
      }
