[
  {
    "name": "rg",
    "description": "Reserved ripgrep search. Phase 5 returns sandbox_unavailable.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "pattern": {"type": "string", "minLength": 1, "maxLength": 2048},
        "mode": {"type": "string", "enum": ["regex", "literal"]},
        "case_sensitive": {"type": "boolean"},
        "ids": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1, "maximum": 2147483647},
          "maxItems": 100,
          "minItems": 1
        },
        "context_lines": {"type": "integer", "minimum": 0, "maximum": 5},
        "limit": {"type": "integer", "minimum": 1, "maximum": 100},
        "cursor": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "required": ["pattern"],
      "additionalProperties": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_arguments",
            "invalid_query_syntax",
            "unknown_query_field",
            "unknown_relation",
            "query_too_complex",
            "invalid_regex",
            "rfc_not_found",
            "section_not_found",
            "ambiguous_section",
            "invalid_byte_range",
            "invalid_utf8_boundary",
            "unsupported_source_encoding",
            "cursor_invalid",
            "cursor_expired",
            "generation_unavailable",
            "corpus_not_ready",
            "incomplete_index",
            "deadline_exceeded",
            "resource_limit_exceeded",
            "sandbox_unavailable",
            "source_policy_restricted",
            "source_unavailable",
            "search_unavailable"
          ]
        },
        "message": {"type": "string"},
        "span": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "minItems": 2,
          "maxItems": 2
        },
        "candidate_section_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}, "maxItems": 10},
        "source_url": {"type": "string"}
      },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  },
  {
