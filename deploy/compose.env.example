# Use immutable qualified image references for deployment.
RFC_SERVE_IMAGE=rfc-mcp-local-serve:phase7
RFC_SYNC_IMAGE=rfc-mcp-local-sync:phase7
RFC_FEED_IMAGE=rfc-mcp-local-feed:phase7
RFC_INGRESS_NETWORK=rfc-public-ingress
RFC_INGRESS_SERVE_IP=172.30.70.2
RFC_INGRESS_PROXY_IP=172.30.70.3
RFC_MCP_HOSTS=rfc.example.invalid
RFC_MCP_ORIGINS=https://rfc.example.invalid
RFC_DB_READ_SUBNET=172.30.70.16/28
RFC_DB_WRITE_SUBNET=172.30.70.32/28
RFC_NOTIFY_SUBNET=172.30.70.48/28
RFC_NOTIFY_SERVE_IP=172.30.70.50
RFC_NOTIFY_DYNAMIC_RANGE=172.30.70.56/29
RFC_CONTROL_SUBNET=172.30.70.64/28
RFC_CONTROL_SYNC_IP=172.30.70.66
RFC_CONTROL_DYNAMIC_RANGE=172.30.70.72/29
RFC_FEED_FORMAT=atom
RFC_SYNC_SERVE_KEY_ID=notification-v1
RFC_FEED_SYNC_KEY_ID=feed-v1

RFC_MIRROR_DIR=/srv/rfc-mcp/mirror
RFC_SYNC_CONFIG_HOST_FILE=/srv/rfc-mcp/config/ingestion.toml
RFC_PGDATA_DIR=/srv/rfc-mcp/pgdata
RFC_PG_HBA=/srv/rfc-mcp/config/pg_hba.conf
RFC_DB_CA=/srv/rfc-mcp/config/db-ca.crt
RFC_POSTGRES_CERT=/srv/rfc-mcp/config/postgres.crt
RFC_POSTGRES_KEY=/srv/rfc-mcp/private/postgres/tls.key
RFC_POSTGRES_PASSWORD=/srv/rfc-mcp/private/postgres/bootstrap-password
RFC_SERVE_DB_PASSWORD=/srv/rfc-mcp/private/serve/database-password
RFC_SYNC_DB_PASSWORD=/srv/rfc-mcp/private/sync/database-password
RFC_SERVE_CURSOR_KEY=/srv/rfc-mcp/private/serve/cursor-key
RFC_SERVE_NOTIFY_KEY=/srv/rfc-mcp/private/serve/notification-key
RFC_SYNC_NOTIFY_KEY=/srv/rfc-mcp/private/sync/notification-key
RFC_SYNC_FEED_KEY=/srv/rfc-mcp/private/sync/feed-key
RFC_FEED_FEED_KEY=/srv/rfc-mcp/private/feed/feed-key
