# HTTPS-first Sync configuration. This file contains no credentials.
schema_version = 2

[ingestion]
target_bootstrap_seconds = 900
max_accepted_bytes = 4294967296

[ingestion.discovery]
inventory_timeout_seconds = 120
full_reconcile_interval_seconds = 86400

[ingestion.https]
max_in_flight_requests = 2
min_request_start_interval_ms = 1000
request_timeout_seconds = 30
max_attempts = 3

# Phase 1 validates the following settings for their later runtime consumers.
[ingestion.pipeline]
txt_queue_items = 64
xml_queue_items = 64
result_queue_items = 32
max_active_documents = 3
parser_workers = 2
raw_payload_budget_bytes = 50331648
parse_budget_bytes = 402653184

[ingestion.revalidation]
max_rsync_sessions = 1
batch_size = 512
session_timeout_seconds = 120
interval_seconds = 86400
max_attempts = 3
retry_backoff_seconds = [5, 30]

[ingestion.database]
batch_size = 32
